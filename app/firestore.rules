rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esDueno(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // Suscripción vigente: solo las Cloud Functions escriben usuarios/{uid}.suscripcion
    function suscrito(uid) {
      let u = get(/databases/$(database)/documents/usuarios/$(uid));
      return u.data.get('suscripcion', {}).get('vence', null) is timestamp
        && u.data.suscripcion.vence > request.time;
    }
    function estadoValido() {
      return request.resource.data.estado in ['apartado', 'pagado'];
    }

    match /usuarios/{uid} {
      allow read: if esDueno(uid);
      allow write: if false;

      match /rifas/{rifaId} {
        allow read: if esDueno(uid);
        allow create: if esDueno(uid) && suscrito(uid);
        // Una rifa realizada (con número ganador) ya no cambia; solo se puede pasar al historial.
        allow update: if esDueno(uid) && suscrito(uid) && (
          resource.data.get('estado', 'activa') != 'finalizada'
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archivada']));
        allow delete: if false;

        function rifaAbierta() {
          return get(/databases/$(database)/documents/usuarios/$(uid)/rifas/$(rifaId)).data.get('estado', 'activa') != 'finalizada';
        }

        match /numeros/{numero} {
          allow read: if esDueno(uid);
          allow create: if esDueno(uid) && suscrito(uid) && rifaAbierta() && estadoValido();
          // Un número PAGADO queda bloqueado: no se puede modificar ni liberar.
          allow update: if esDueno(uid) && suscrito(uid) && rifaAbierta() && estadoValido()
                        && resource.data.estado != 'pagado';
          allow delete: if esDueno(uid) && suscrito(uid) && rifaAbierta()
                        && resource.data.estado != 'pagado';
        }
      }
    }
  }
}
